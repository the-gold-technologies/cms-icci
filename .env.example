# =========================================================================
# ICCI CMS - Environment Configuration Template
# Indian Chamber of Construction Industry (website repo: ../icci)
# =========================================================================

DATABASE_URL="postgresql://username:password@localhost:5432/icci_cms"
DIRECT_URL="postgresql://username:password@localhost:5432/icci_cms"

AUTH_SECRET="your-generated-auth-secret-here"
NEXTAUTH_URL="http://localhost:3001"

# Website (for revalidation pings) and its public domain (canonical URLs, sitemap)
NEXT_PUBLIC_WEBSITE_URL="http://localhost:3000"
NEXT_PUBLIC_WEBSITE_URL="https://icci.co.in"

# Cloudinary Configuration
CLOUDINARY_URL=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="icci"

# SMTP Configuration for membership & contact enquiry alerts
SMTP_HOST=""
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
# Display name only; mail is always sent from SMTP_USER
SMTP_FROM_NAME="ICCI Website"
ADMIN_NOTIFICATION_EMAIL="contact@icci.co.in"

# Shared Secret with the website for revalidation webhook & submissions
CMS_SHARED_SECRET="icci-secret-key-replace-in-production"

# First admin account created by `npm run seed` (only if it does not exist yet)
SEED_ADMIN_EMAIL="admin@icci.co.in"
SEED_ADMIN_PASSWORD=""
